# Required
TORBOX_API_KEY=your-torbox-api-key
SAB_API_KEY=choose-a-random-string   # enter the same value in Radarr/Sonarr

# Optional: TorBox limits (defaults fit the Pro plan)
# TORBOX_MAX_ACTIVE=10
# TORBOX_SUBMITS_PER_HOUR=55

# Optional: Radarr/Sonarr access (enables stuck-import handling; with REQUIRED_AUDIO_LANGS also the language guard)
# ARRS=radarr|http://radarr:7878|RADARR_API_KEY,sonarr|http://sonarr:8989|SONARR_API_KEY
# REQUIRED_AUDIO_LANGS=ger,deu,german
# GUARD_RELEASE_REGEX=\bMULTI\b

# Optional: cleanup of unused TorBox downloads (DELETES items in your TorBox account, read the README first)
# CLEANUP_ENABLED=1
# CLEANUP_DRY_RUN=1
# EXTRA_LINK_ROOTS=/mnt/decypharr/__all__
